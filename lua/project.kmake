//Build script for use with kalamake. Read more at https://github.com/kalakit/kalamake

#version 1.0

#references
name_bin: lua

#global
compilerlauncher: ccache
compiler: clang
standard: c17
binarytype: static
sources: "onelua.c"
headers: "."
defines: MAKE_LIB
warninglevel: normal

#profile debug-windows
binaryname: ${name_bin}d
buildtype: debug
buildpath: "debug"

#profile release-windows
binaryname: ${name_bin}
buildtype: minsizerel
buildpath: "release"

#profile debug-win-on-linux
targettype: windows-gnu
binaryname: ${name_bin}-gnud
buildtype: debug
buildpath: "debug"

#profile release-win-on-linux
targettype: windows-gnu
binaryname: ${name_bin}-gnu
buildtype: minsizerel
buildpath: "release"

#profile debug-linux
binaryname: lib${name_bin}d
buildtype: debug
buildpath: "debug"

#profile release-linux
binaryname: lib${name_bin}
buildtype: minsizerel
buildpath: "release"
